# Local / shared environment template (never commit real secrets).
# Copy to `.env` at the repo root.

# ════════════════════════════════════════════════
# 1. CLAUDE — CHEMIN SYNCHRONE ET PARCOURS SUJETS
# ════════════════════════════════════════════════
# Avec AI_PROVIDER=anthropic|bedrock|vertex, le client Claude SDK est utilisé
# (sujets + analyse sync). AI_BASE_URL / AI_API_KEY ne sont alors PAS requis.
# Conservez-les uniquement pour le mode openai-compatible.
AI_BASE_URL=
AI_MODEL=claude-sonnet-5-5
AI_API_KEY=

# ════════════════════════════════════════════════
# 2. CLAUDE — PIPELINE
# ════════════════════════════════════════════════
# Valeurs : anthropic | bedrock | vertex | openai-compatible (ou absent)
AI_PROVIDER=anthropic
# Analyse async des corpus > 120 000 car. (1/true/yes/on). Désactivé = 413 comme avant.
RESEARCH_PIPELINE=1
ANTHROPIC_API_KEY=
# Modèles (défauts code : claude-haiku-5-5 / claude-sonnet-5-5)
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
# Parallélisme temps réel (défaut 4) ; seuil d’unités pour proposer le mode lot (défaut 800)
AI_CONCURRENCY=4
AI_BATCH_THRESHOLD=800

# ════════════════════════════════════════════════
# 3. LIMITES ET CONSERVATION
# ════════════════════════════════════════════════
# Plafond caractères texte extrait / document (défaut 3000000). Front : VITE_MAX_TEXT_CHARS.
MAX_TEXT_CHARS=3000000
VITE_MAX_TEXT_CHARS=3000000
# Conservation ObjectStore (jours) : cache analyses sync (défaut 90) ; jobs terminés (défaut 30).
RESEARCH_CACHE_MAX_DAYS=90
JOB_RETENTION_DAYS=30

# ════════════════════════════════════════════════
# 4. BEDROCK / VERTEX — non utilisés avec AI_PROVIDER=anthropic
# ════════════════════════════════════════════════
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
CLOUD_ML_REGION=
ANTHROPIC_VERTEX_PROJECT_ID=

# ════════════════════════════════════════════════
# 5. APPLICATION
# ════════════════════════════════════════════════
# Application-level AES-GCM key for free-text answers and generated topics (étape D).
PROFILE_ENCRYPTION_KEY=
TOPICS_TICKET_SECRET=
COOKIE_SECRET=
DATABASE_URL=
APP_BASE_URL=http://127.0.0.1:5173
# Démonstration sujets/docs sans IA (hors production uniquement). Laisser à false.
ALLOW_SIMULATION=false
# Front (Vite) : affiche la case « Mode démonstration » uniquement si DEV + true.
VITE_ALLOW_SIMULATION=false
# OpenAlex polite pool (email) — lectures vérifiées des sujets. Optionnel.
OPENALEX_MAILTO=
# Clé gratuite à créer sur https://openalex.org/settings/api
OPENALEX_API_KEY=
