# Local / shared environment template (never commit real secrets).
# OpenAI-compatible (parcours sujets + plan corpus actuel). Défaut si AI_PROVIDER est absent.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Pipeline Claude (lots 1+). Absent ou openai-compatible = comportement actuel inchangé.
# Valeurs : anthropic | bedrock | vertex | openai-compatible
AI_PROVIDER=
# Analyse async des corpus > 120 000 car. (1/true/yes/on). Désactivé = 413 comme avant.
RESEARCH_PIPELINE=
ANTHROPIC_API_KEY=
# Modèles (défauts code : claude-haiku-5-5 / claude-sonnet-5-5)
AI_MODEL_FAST=
AI_MODEL_SMART=
# Parallélisme temps réel (défaut 4) ; seuil d’unités pour proposer le mode lot (défaut 800)
AI_CONCURRENCY=
AI_BATCH_THRESHOLD=
# Plafond caractères texte extrait / document (défaut 3000000). Front : VITE_MAX_TEXT_CHARS.
MAX_TEXT_CHARS=
VITE_MAX_TEXT_CHARS=
# Conservation ObjectStore (jours) : cache analyses sync (défaut 90) ; jobs terminés (défaut 30).
RESEARCH_CACHE_MAX_DAYS=
JOB_RETENTION_DAYS=

# Bedrock (traitement possible dans l’UE via la région AWS). Message Batches API non disponible.
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Vertex (traitement possible dans l’UE via la région GCP). Message Batches API non disponible.
CLOUD_ML_REGION=
ANTHROPIC_VERTEX_PROJECT_ID=

# Application-level AES-GCM key for free-text answers and generated topics (étape D).
# Leave empty while persistence is disabled (étape A).
PROFILE_ENCRYPTION_KEY=
TOPICS_TICKET_SECRET=
COOKIE_SECRET=
DATABASE_URL=
APP_BASE_URL=http://127.0.0.1:5173
