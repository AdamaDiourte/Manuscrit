{$DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 22MiB
    }
    reverse_proxy identity:4180 {
        header_up -X-Manuscrit-User
        header_up -X-Forwarded-User
        header_up -X-Forwarded-Email
        header_up -X-Auth-Request-*
    }
}
:8080 {
    reverse_proxy application:3000 {
        header_up X-Manuscrit-User {http.request.header.X-Forwarded-User}
    }
}
